<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12+ (API 31+), consumed via
  android:dataExtractionRules. Same content as backup_rules.xml, split
  between cloud backup (Google account) and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="app_flutter/"/>
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="app_flutter/"/>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
